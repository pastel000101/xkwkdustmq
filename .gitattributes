# ============================================================
# .gitattributes — 영어 타자연습
# ------------------------------------------------------------
# 이 저장소의 파일은 전부 UTF-8 텍스트다.
# 콘텐츠에 한글이 많으므로 인코딩과 줄바꿈을 명시해 둔다.
#
# text=auto  저장소 안에서는 LF 로 정규화하고,
#            체크아웃 시에는 각자의 core.autocrlf 설정을 따른다.
#            Windows 와 macOS 에서 같은 파일이 서로 다르게 보이는 것을 막는다.
# ============================================================

* text=auto

# ---- 텍스트로 명시 ----
*.html   text
*.css    text
*.js     text
*.json   text
*.md     text
*.txt    text
.gitignore     text
.gitattributes text

# ---- 이 저장소에는 바이너리가 없다 ----
# 나중에 이미지·폰트를 추가한다면 아래 주석을 풀 것
# *.png  binary
# *.jpg  binary
# *.woff2 binary

# ---- diff 를 보기 좋게 ----
*.md     diff=markdown
*.html   diff=html
*.css    diff=css
